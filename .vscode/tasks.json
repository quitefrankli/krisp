{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build krisp (debug)",
			"type": "shell",
			"command": "meson compile -C build/debug -j 6 krisp",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "build krisp (release)",
			"type": "shell",
			"command": "meson compile -C build/release -j 6 krisp",
			"group": {
				"kind": "build",
				"isDefault": false
			}
		},
		{
			"label": "build tests (debug)",
			"type": "shell",
			"command": "meson compile -C build/debug -j 6 krisp_tests",
			"group": {
				"kind": "build",
				"isDefault": false
			}
		}
	]
}
